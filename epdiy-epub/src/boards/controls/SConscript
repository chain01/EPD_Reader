Import('RTT_ROOT')
Import('rtconfig')
from building import *

cwd = GetCurrentDir()
src = Glob('*.cpp')
if GetDepend('READER_E0470A03'):
    src = [s for s in src if os.path.basename(str(s)) != 'SF32_ButtonControls.cpp']
CPPPATH = [cwd]

group = DefineGroup('controls', src,depend = [''],CPPPATH = CPPPATH)

Return('group')
